BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Para acessar por IP, liste as URLs exatas separadas por vírgula.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Opcional: amplia a lista de cotações de ações brasileiras exibidas no painel.
BRAPI_TOKEN=
DATABASE_URL=postgresql://clareza:clareza_local@127.0.0.1:5433/controle_financeiro

# Imagens privadas em disco, fora de public/. Use supabase para o serviço remoto.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.local/uploads

# Opcional: somente para STORAGE_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Apenas no servidor. Nunca prefixe esta chave com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=finance-uploads
