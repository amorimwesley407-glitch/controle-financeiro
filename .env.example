BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Opcional: amplia a lista de cotações de ações brasileiras exibidas no painel.
BRAPI_TOKEN=
# Use a URL do Transaction Pooler do Supabase (porta 6543) na Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# Apenas no servidor. Nunca prefixe esta chave com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=finance-uploads
# Só em servidor próprio acessado por http (não use na Vercel).
# ALLOW_HTTP=true
# Opcional: palavras pessoais (nomes de pessoas, lugares) que viram categoria de despesa automaticamente.
# Formato: Categoria=palavra|outra;OutraCategoria=palavra
# CATEGORY_KEYWORDS=Presentes=fulano|ciclano
